// Firebase 콘솔 > Firestore Database > 규칙 탭에 이 내용을 그대로
// 붙여넣고 "게시"를 누르세요.
//
// 의미: 로그인(익명 로그인 포함)한 사람만 가족 공간(families/그 아래 전부)을
// 읽고 쓸 수 있습니다. 어느 가족 공간인지는 무작위로 만들어진 긴 코드로
// 구분되므로, 이 코드(=공유 링크)를 아는 사람만 실질적으로 접근할 수 있습니다.
// 링크를 가족 외의 사람과 공유하지 않으면 안전합니다.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /families/{familyId}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
